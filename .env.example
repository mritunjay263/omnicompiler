# OmniCompiler Environment Configuration

# Public application URL (used for Schema.org, OpenGraph images, and sitemap)
NEXT_PUBLIC_APP_URL=https://omnicompiler.vercel.app

# Cryptographic secret for signing developer SSO session tokens
SESSION_SECRET=replace_with_a_secure_random_string_in_production

# Node environment
NODE_ENV=production
PORT=3000

# ==========================================
# External Web Traffic Analytics (100% Free)
# ==========================================
# 1. Google Analytics 4 (GA4 Measurement ID e.g. G-XXXXXXXXXX)
# Get yours free at: https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# 2. Google Search Console Verification Meta Tag Token
# Get yours free at: https://search.google.com/search-console
NEXT_PUBLIC_GSC_VERIFICATION=

# 3. Cloudflare Web Analytics Token (Privacy-first, 100% free)
# Get yours free at: https://dash.cloudflare.com
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
